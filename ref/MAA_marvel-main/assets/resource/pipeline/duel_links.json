{
    "Config_PackageName": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DuelLinksRecordState",
                "custom_action_param": {
                    "event": "config",
                    "package_name": "jp.konami.duellinks",
                    "world": 0,
                    "start_area": 0,
                    "current_area": 0,
                    "loop_areas": true,
                    "enable_clicks": true,
                    "color_tolerance": 24,
                    "scan_step": 2
                }
            }
        },
        "next": [
            "决斗链接-启动游戏"
        ]
    },
    "决斗链接-任务入口": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DuelLinksRecordState",
                "custom_action_param": {
                    "event": "task_started"
                }
            }
        },
        "next": [
            "Config_PackageName"
        ]
    },
    "决斗链接-启动游戏": {
        "action": {
            "type": "StartApp",
            "param": {
                "package": "jp.konami.duellinks"
            }
        },
        "post_delay": 8000,
        "next": [
            "决斗链接-ADB截图预热"
        ],
        "on_error": [
            "决斗链接-记录启动失败"
        ]
    },
    "决斗链接-ADB截图预热": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DuelLinksWarmupScreencap",
                "custom_action_param": {
                    "timeout_ms": 60000,
                    "interval_ms": 1000,
                    "expected_width": 720,
                    "expected_height": 1280
                }
            }
        },
        "next": [
            "决斗链接-街头决斗循环"
        ],
        "on_error": [
            "决斗链接-记录截图预热失败"
        ]
    },
    "决斗链接-街头决斗循环": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DuelLinksStreetDuelStep",
                "custom_action_param": {}
            }
        },
        "post_delay": 1000,
        "next": [
            "决斗链接-街头决斗循环"
        ],
        "on_error": [
            "决斗链接-识别当前状态"
        ],
        "rate_limit": 1200
    },
    "决斗链接-识别当前状态": {
        "next": [
            "决斗链接-主页OCR",
            "决斗链接-区域OCR",
            "决斗链接-决斗状态OCR",
            "决斗链接-未知状态"
        ],
        "rate_limit": 1000,
        "timeout": 10000,
        "on_error": [
            "决斗链接-未知状态"
        ]
    },
    "决斗链接-主页OCR": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    0,
                    720,
                    1280
                ],
                "expected": [
                    "(?i).*duel links.*",
                    ".*决斗链接.*",
                    ".*Duel World.*",
                    ".*DUEL WORLD.*"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DuelLinksRecordState",
                "custom_action_param": {
                    "event": "page_home"
                }
            }
        },
        "next": [
            "决斗链接-街头决斗循环"
        ]
    },
    "决斗链接-区域OCR": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    0,
                    720,
                    1280
                ],
                "expected": [
                    ".*Gate.*",
                    ".*Shop.*",
                    ".*Studio.*",
                    ".*DM.*",
                    ".*GX.*",
                    ".*5D.*",
                    ".*ZEXAL.*",
                    ".*ARC-V.*",
                    ".*VRAINS.*",
                    ".*SEVENS.*",
                    ".*GO RUSH.*"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DuelLinksRecordState",
                "custom_action_param": {
                    "event": "area_visible"
                }
            }
        },
        "next": [
            "决斗链接-街头决斗循环"
        ]
    },
    "决斗链接-决斗状态OCR": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    0,
                    720,
                    1280
                ],
                "expected": [
                    ".*Duel.*",
                    ".*Turn.*",
                    ".*Main Phase.*",
                    ".*Battle Phase.*",
                    ".*Draw Phase.*",
                    ".*End Phase.*",
                    ".*AUTO.*"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DuelLinksRecordState",
                "custom_action_param": {
                    "event": "duel_state_visible"
                }
            }
        },
        "next": [
            "决斗链接-街头决斗循环"
        ]
    },
    "决斗链接-未知状态": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DuelLinksRecordState",
                "custom_action_param": {
                    "event": "unknown_state"
                }
            }
        },
        "next": [
            "决斗链接-街头决斗循环"
        ],
        "rate_limit": 3000
    },
    "决斗链接-记录启动失败": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DuelLinksRecordState",
                "custom_action_param": {
                    "event": "start_failed"
                }
            }
        },
        "next": [
            "决斗链接-停止-失败"
        ]
    },
    "决斗链接-记录截图预热失败": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DuelLinksRecordState",
                "custom_action_param": {
                    "event": "screencap_warmup_failed"
                }
            }
        },
        "next": [
            "决斗链接-停止-失败"
        ]
    },
    "决斗链接-切换Gate": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DuelLinksSwitchArea",
                "custom_action_param": {"area": "Gate"}
            }
        }
    },
    "决斗链接-切换Duel": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DuelLinksSwitchArea",
                "custom_action_param": {"area": "Duel"}
            }
        }
    },
    "决斗链接-切换Shop": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DuelLinksSwitchArea",
                "custom_action_param": {"area": "Shop"}
            }
        }
    },
    "决斗链接-切换Studio": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DuelLinksSwitchArea",
                "custom_action_param": {"area": "Studio"}
            }
        }
    },
    "决斗链接-识别当前区域决斗者": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DuelLinksExportDuelistDetections",
                "custom_action_param": {}
            }
        }
    },
    "决斗链接-打开识别结果": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DuelLinksOpenDetectionFolder",
                "custom_action_param": {}
            }
        }
    },
    "决斗链接-停止-失败": {
        "action": {
            "type": "StopTask"
        }
    }
}
