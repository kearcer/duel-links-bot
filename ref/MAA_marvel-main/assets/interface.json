{
    "interface_version": 2,
    "name": "Duel Links Maa",
    "description": "游戏王：决斗链接竖屏 Android MuMu/ADB 自动化最小骨架",
    "license": "MIT",
    "welcome": "请选择 720×1280 竖屏模式的 MuMu 或其他 Android ADB 模拟器后开始任务。当前已验证包名为 jp.konami.duellinks。",
    "github": "https://github.com/Robotwizardt/MAA_marvel",
    "version": "0.1.0",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "Duel Links",
            "path": [
                "./resource"
            ]
        }
    ],
    "pretask": [
        {
            "name": "connect_mumu_adb",
            "label": "连接 MuMu ADB",
            "exec": "./connect_mumu_adb.bat"
        },
        {
            "name": "roi_annotation_tool",
            "label": "打开 ROI 标注工具",
            "description": "获取当前游戏截图并打开 ROI 标注、命名和保存界面。",
            "exec": "./run_roi_tool.bat"
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "-m",
            "agent.main"
        ]
    },
    "task": [],
    "option": {},
    "import": [
        "tasks/决斗链接挂机.json"
    ]
}
