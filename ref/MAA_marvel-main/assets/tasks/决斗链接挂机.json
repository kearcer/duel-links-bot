{
    "task": [
        {
            "name": "决斗链接挂机",
            "entry": "决斗链接-任务入口",
            "default_check": true,
            "resource": [
                "Duel Links"
            ],
            "controller": [
                "安卓端"
            ],
            "description": "Duel Links 竖屏 MuMu/ADB 街头决斗循环：启动、截图预热、迁移旧脚本的奖励/决斗者颜色搜索决策。",
            "option": [
                "决斗链接-Android包名",
                "决斗链接-世界",
                "决斗链接-起始区域",
                "决斗链接-循环区域",
                "决斗链接-启用点击"
            ]
        },
        {
            "name": "切换到 Gate",
            "entry": "决斗链接-切换Gate",
            "default_check": false,
            "resource": ["Duel Links"],
            "controller": ["安卓端"],
            "description": "点击底部导航切换到 Gate。"
        },
        {
            "name": "切换到 Duel",
            "entry": "决斗链接-切换Duel",
            "default_check": false,
            "resource": ["Duel Links"],
            "controller": ["安卓端"],
            "description": "点击底部导航切换到 Duel。"
        },
        {
            "name": "切换到 Shop",
            "entry": "决斗链接-切换Shop",
            "default_check": false,
            "resource": ["Duel Links"],
            "controller": ["安卓端"],
            "description": "点击底部导航切换到 Shop。"
        },
        {
            "name": "切换到 Studio",
            "entry": "决斗链接-切换Studio",
            "default_check": false,
            "resource": ["Duel Links"],
            "controller": ["安卓端"],
            "description": "点击底部导航切换到 Studio。"
        },
        {
            "name": "识别当前区域决斗者",
            "entry": "决斗链接-识别当前区域决斗者",
            "default_check": false,
            "resource": ["Duel Links"],
            "controller": ["安卓端"],
            "description": "保存当前画面及每个颜色命中决斗者的裁剪图到 debug/duel_links_detections。"
        },
        {
            "name": "打开识别结果文件夹",
            "entry": "决斗链接-打开识别结果",
            "default_check": false,
            "resource": ["Duel Links"],
            "controller": ["安卓端"],
            "description": "打开最近一次决斗者识别结果目录。"
        }
    ],
    "option": {
        "决斗链接-Android包名": {
            "type": "input",
            "label": "Android 包名",
            "description": "用于 StartApp 启动 Duel Links；国际服/渠道服可在这里覆盖。",
            "inputs": [
                {
                    "name": "Android包名",
                    "label": "Android 包名",
                    "default": "jp.konami.duellinks",
                    "pipeline_type": "string",
                    "verify": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$",
                    "pattern_msg": "请输入合法 Android 包名，例如 jp.konami.duellinks"
                }
            ],
            "pipeline_override": {
                "Config_PackageName": {
                    "action": {
                        "param": {
                            "custom_action_param": {
                                "package_name": "{Android包名}"
                            }
                        }
                    }
                },
                "决斗链接-启动游戏": {
                    "action": {
                        "param": {
                            "package": "{Android包名}"
                        }
                    }
                }
            }
        },
        "决斗链接-世界": {
            "type": "select",
            "label": "决斗世界",
            "description": "沿用旧脚本的世界到街头决斗者列表映射。",
            "default_case": "dm",
            "cases": [
                {
                    "name": "dm",
                    "label": "DM",
                    "pipeline_override": {
                        "Config_PackageName": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "world": 0
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "gx",
                    "label": "GX",
                    "pipeline_override": {
                        "Config_PackageName": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "world": 1
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "arcv",
                    "label": "ARC-V",
                    "pipeline_override": {
                        "Config_PackageName": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "world": 4
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "vrains",
                    "label": "VRAINS",
                    "pipeline_override": {
                        "Config_PackageName": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "world": 5
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "sevens",
                    "label": "SEVENS",
                    "pipeline_override": {
                        "Config_PackageName": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "world": 7
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "决斗链接-起始区域": {
            "type": "select",
            "label": "起始区域",
            "description": "迁移旧脚本区域顺序：Gate、Duel、Shop、Studio。当前先记录区域推进，不强制点底部页签。",
            "default_case": "gate",
            "cases": [
                {
                    "name": "gate",
                    "label": "Gate",
                    "pipeline_override": {
                        "Config_PackageName": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "start_area": 0,
                                        "current_area": 0
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "duel",
                    "label": "Duel",
                    "pipeline_override": {
                        "Config_PackageName": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "start_area": 1,
                                        "current_area": 1
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "shop",
                    "label": "Shop",
                    "pipeline_override": {
                        "Config_PackageName": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "start_area": 2,
                                        "current_area": 2
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "studio",
                    "label": "Studio",
                    "pipeline_override": {
                        "Config_PackageName": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "start_area": 3,
                                        "current_area": 3
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "决斗链接-循环区域": {
            "type": "switch",
            "label": "循环四个区域",
            "description": "开启后到 Studio 后回到起始区域继续搜索。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "Config_PackageName": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "loop_areas": true
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "Config_PackageName": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "loop_areas": false
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "决斗链接-启用点击": {
            "type": "switch",
            "label": "识别到目标后点击",
            "description": "关闭后只记录识别结果，便于首次调试。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "点击",
                    "pipeline_override": {
                        "Config_PackageName": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "enable_clicks": true
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "只记录",
                    "pipeline_override": {
                        "Config_PackageName": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "enable_clicks": false
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        }
    }
}
